    25                  
    26                  ;------------ Setup Timers ------------
    27                  ;TIMER 0
    28        0000      T0_G	EQU	0	;GATE
    29        0000      T0_C	EQU	0	;COUNTER/-TIMER
    30        0001      T0_M	EQU	1	;MODE (0..3)
    31        0001      TIM0	EQU	T0_M+T0_C*4+T0_G*8
    32                  ;TIMER 1
    33        0000      T1_G	EQU	0	;GATE
    34        0000      T1_C	EQU	0	;COUNTER/-TIMER
    35        0000      T1_M	EQU	0	;MODE (0..3)
    36        0000      TIM1	EQU	T1_M+T1_C*4+T1_G*8
    37                  
    38        0001      TMOD_SET	EQU	TIM0+TIM1*16
    39                  
    40                  ;50[ms] = 50 000[uS]*(11.0592[MHz]/12) =
    41                  ;	= 46 080 cycles = 180 * 256
    42        004C      TH0_SET		EQU	256-180
    43        0000      TL0_SET		EQU	0
    44                  ;---------------------------------------
    45                  
    46        0097      LED	EQU	P1.7 ; Define LED pin
    47        0095      BUZZ EQU P1.5 ; Define Buzzer pin
    48                  
    49                  ; Define alarm time storage in the RAM
    50        0033      ALM_H EQU 33H ; Hour of the alarm
    51        0034      ALM_M EQU 34H ; Minute of the alarm
    52        0035      ALM_C EQU 35H ; Counter for alarm duration in seconds
    53                  
    54  0000: 02 01 00      LJMP START
    55  0100:               ORG 100H ; Jump to the start of the program
    56  0100:           START:
    57  0100: 12 81 08      LCALL LCD_INIT
    58                  
    59  0103: 75 89 01      MOV TMOD, #TMOD_SET ; Timer 0 is counting
    60  0106: 75 8C 4C      MOV TH0, #TH0_SET ; Set timer 0 to 50ms
    61  0109: 75 8A 00      MOV TL0, #TL0_SET
    62  010C: D2 8C         SETB TR0 ; Start timer 0
    63                  
    64                      ; Setup current time
    65  010E: 12 01 29      LCALL SET_CURRENT_TIME
    66                  
    67                      ; Setup alarm time
    68  0111: 12 01 6C      LCALL SET_ALARM_TIME
    69                  
    70  0114: 75 35 00      MOV ALM_C, #0 ; Reset alarm counter
    71  0117: D2 97         SETB LED ; Turn off the LED
    72  0119: D2 95         SETB BUZZ ; Turn off the Buzzer
    73                  
    74  011B:           MAIN_LOOP:
    75                      ; Display the current time on the LCD
    76  011B: 12 01 9C      LCALL DISPLAY_TIME
    77                  
    78                      ; Check if the alarm time has been reached
    79  011E: 12 01 C7      LCALL CHECK_ALARM
    80                  
    81                      ; One second delay
    82  0121: 12 01 E3      LCALL DELAY_1S
    83                      
    84                      ; One second increase of the current time
    85  0124: 12 01 F9      LCALL INC_TIME
    86                  
    87  0127: 80 F2         SJMP MAIN_LOOP
    88                  
    89  0129:           SET_CURRENT_TIME:
    90  0129: 12 81 0C      LCALL LCD_CLR
    91                      ; HOUR
    92  012C: 12 81 1C      LCALL WAIT_KEY ; Get XO
    93  012F: 75 F0 0A      MOV B, #10
    94  0132: A4            MUL AB
    95  0133: F9            MOV R1,A
    96                      
    97  0134: 12 81 1C      LCALL WAIT_KEY ; Get OX
    98  0137: 29            ADD A,R1
    99                  
   100  0138: FF            MOV R7,A
   101  0139: 12 01 B6      LCALL PRINT_DEC
   102                  
   103  013C: 74 3A         MOV A, #':'
   104  013E: 12 81 02      LCALL WRITE_DATA
   105                      
   106                      ; MIN
   107  0141: 12 81 1C      LCALL WAIT_KEY ; Get XO
   108  0144: 75 F0 0A      MOV B, #10
   109  0147: A4            MUL AB
   110  0148: F9            MOV R1,A
   111                      
   112  0149: 12 81 1C      LCALL WAIT_KEY ; Get OX
   113  014C: 29            ADD A,R1
   114                  
   115  014D: FE            MOV R6,A
   116  014E: 12 01 B6      LCALL PRINT_DEC
   117                  
   118  0151: 74 3A         MOV A, #':'
   119  0153: 12 81 02      LCALL WRITE_DATA
   120                  
   121                      ; SEX
   122  0156: 12 81 1C      LCALL WAIT_KEY ; Get XO
   123  0159: 75 F0 0A      MOV B, #10
   124  015C: A4            MUL AB
   125  015D: F9            MOV R1,A
   126                      
   127  015E: 12 81 1C      LCALL WAIT_KEY ; Get OX
   128  0161: 29            ADD A,R1
   129                  
   130  0162: FD            MOV R5,A
   131  0163: 12 01 B6      LCALL PRINT_DEC
   132                      
   133  0166: 74 02         MOV A, #2
   134  0168: 12 81 12      LCALL DELAY_100MS
   135                  
   136  016B: 22            RET ; Return from subroutine
   137                  
   138  016C:           SET_ALARM_TIME:
   139  016C: 12 81 0C      LCALL LCD_CLR
   140                  
   141                      ; HOUR alarm
   142  016F: 12 81 1C      LCALL WAIT_KEY
   143  0172: 75 F0 0A      MOV B, #10
   144  0175: A4            MUL AB
   145  0176: F9            MOV R1,A
   146  0177: 12 81 1C      LCALL WAIT_KEY
   147  017A: 29            ADD A,R1
   148  017B: F5 33         MOV ALM_H, A      ; Write to RAM
   149  017D: 12 01 B6      LCALL PRINT_DEC
   150                  
   151  0180: 74 3A         MOV A, #':'
   152  0182: 12 81 02      LCALL WRITE_DATA
   153                      
   154                      ; MIN alarm
   155  0185: 12 81 1C      LCALL WAIT_KEY
   156  0188: 75 F0 0A      MOV B, #10
   157  018B: A4            MUL AB
   158  018C: F9            MOV R1,A
   159  018D: 12 81 1C      LCALL WAIT_KEY
   160  0190: 29            ADD A,R1
   161  0191: F5 34         MOV ALM_M, A      ; Write to RAM
   162  0193: 12 01 B6      LCALL PRINT_DEC
   163                  
   164  0196: 74 02         MOV A, #2
   165  0198: 12 81 12      LCALL DELAY_100MS
   166                  
   167  019B: 22            RET
   168                  
   169  019C:           DISPLAY_TIME:
   170  019C: 12 81 0C      LCALL LCD_CLR
   171  019F: EF            MOV A, R7
   172  01A0: 12 01 B6      LCALL PRINT_DEC ; Print hours
   173                      
   174  01A3: 74 3A         MOV A, #':'
   175  01A5: 12 81 02      LCALL WRITE_DATA
   176                      
   177  01A8: EE            MOV A, R6
   178  01A9: 12 01 B6      LCALL PRINT_DEC ; Print minutes
   179                      
   180  01AC: 74 3A         MOV A, #':'
   181  01AE: 12 81 02      LCALL WRITE_DATA
   182                      
   183  01B1: ED            MOV A, R5
   184  01B2: 12 01 B6      LCALL PRINT_DEC ; Print seconds
   185                  
   186  01B5: 22            RET
   187                  
   188  01B6:           PRINT_DEC:
   189  01B6: 75 F0 0A      MOV B, #10
   190  01B9: 84            DIV AB
   191  01BA: 24 30         ADD A, #'0'
   192  01BC: 12 81 02      LCALL WRITE_DATA
   193  01BF: E5 F0         MOV A, B
   194  01C1: 24 30         ADD A, #'0'
   195  01C3: 12 81 02      LCALL WRITE_DATA
   196                  
   197  01C6: 22            RET
   198                  
   199  01C7:           CHECK_ALARM:
   200                      ; Check seconds
   201  01C7: ED            MOV A, R5
   202  01C8: 70 0B         JNZ ALARM_STATE_UPDATE 
   203                  
   204                      ; Check minutes
   205  01CA: EE            MOV A, R6
   206  01CB: B5 34 07      CJNE A, ALM_M, ALARM_STATE_UPDATE
   207                  
   208                      ; Check hours
   209  01CE: EF            MOV A, R7
   210  01CF: B5 33 03      CJNE A, ALM_H, ALARM_STATE_UPDATE
   211                  
   212                      ; Set alarm counter to 3 seconds when the alarm time is reached
   213  01D2: 75 35 03      MOV ALM_C, #3 
   214                  
   215  01D5:           ALARM_STATE_UPDATE:
   216  01D5: E5 35         MOV A, ALM_C
   217  01D7: 60 05         JZ TURN_OFF_LB
   218  01D9: C2 97         CLR LED ; Turn on the LED
   219  01DB: C2 95         CLR BUZZ ; Turn on the Buzzer
   220                  
   221  01DD: 22            RET
   222                  
   223  01DE:           TURN_OFF_LB:
   224  01DE: D2 97         SETB LED ; Turn off the LED
   225  01E0: D2 95         SETB BUZZ ; Turn off the Buzzer
   226                  
   227  01E2: 22            RET
   228                  
   229  01E3:           DELAY_1S:
   230  01E3: 7A 14         MOV R2, #20 ; 20 * 50ms = 1 second
   231                  
   232  01E5:           DELAY_LOOP:
   233  01E5: 30 8D FD      JNB TF0, $ ; Wait for timer 0 overflow flag
   234  01E8: C2 8D         CLR TF0 ; Clear the flag
   235  01EA: 75 8C 4C      MOV TH0, #TH0_SET
   236  01ED: 75 8A 00      MOV TL0, #TL0_SET
   237  01F0: DA F3         DJNZ R2, DELAY_LOOP
   238                  
   239                      ; Decrease the alarm counter by 1 second
   240  01F2: E5 35         MOV A, ALM_C
   241  01F4: 60 02         JZ SKIP_ALM_DEC
   242  01F6: 15 35         DEC ALM_C
   243                  
   244  01F8:           SKIP_ALM_DEC:
   245  01F8: 22            RET
   246                  
   247  01F9:           INC_TIME:
   248  01F9: 0D            INC R5            ; Increase seconds
   249  01FA: BD 3C 0E      CJNE R5, #60, INC_END
   250  01FD: 7D 00         MOV R5, #0        ; Reset seconds
   251                      
   252  01FF: 0E            INC R6            ; Increase minutes
   253  0200: BE 3C 08      CJNE R6, #60, INC_END
   254  0203: 7E 00         MOV R6, #0        ; Reset minutes
   255                      
   256  0205: 0F            INC R7            ; Increase hours
   257  0206: BF 18 02      CJNE R7, #24, INC_END
   258  0209: 7F 00         MOV R7, #0        ; Reset hours
   259                  
   260  020B:           INC_END:
   261  020B: 22            RET
   262                  
   263  020C:           STOP:
   264  020C: 80 FE         SJMP $
